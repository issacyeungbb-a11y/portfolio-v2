VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# Shared access code. Server-side only: it is checked by /api/health?mode=unlock
# and never bundled into the frontend. Do not use a VITE_ prefix for it.
PORTFOLIO_ACCESS_CODE=your_shared_access_code
# Vercel Cron sends this as "Authorization: Bearer <secret>"; cron routes refuse to run without it.
CRON_SECRET=your_cron_secret
# Server-side Firebase Admin auth for Vercel Functions:
# choose ONE of the following approaches
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={"project_id":"your-project-id","client_email":"firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# or use separate variables
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional override for the read-only Crypto month-log sync. If omitted, the
# Firebase Admin service account above is reused and must be shared on the
# Google Sheet as Viewer (not Editor).
CRYPTO_SHEET_SERVICE_ACCOUNT_JSON={"client_email":"sheet-reader@your-project-id.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
CRYPTO_SHEET_SPREADSHEET_ID=1CrXqZtK2Qy2rivBTN1BZTSbNpAY0Y5P6Rzsg8_OaaI4
CRYPTO_SHEET_SOURCE_RANGE='月結記錄'!A1:S500
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EXTRACT_MODEL=gemini-2.5-flash-lite
GEMINI_ANALYZE_MODEL=gemini-2.5-pro
COINGECKO_API_KEY=your_coingecko_demo_key
# demo (default, api.coingecko.com) or pro (pro-api.coingecko.com)
COINGECKO_PLAN=demo

# Monthly / quarterly reports (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_ANALYZE_MODEL=claude-opus-5-5

# Optional model and fallback overrides (defaults shown)
DEFAULT_ANALYSIS_MODEL=gemini-3.1-pro-preview
GROUNDED_GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY is accepted as an alias when GEMINI_API_KEY is unset.
# AI price fallback for stocks Yahoo cannot price; set AI_PRICE_FALLBACK_ENABLED=0 to turn off.
AI_PRICE_FALLBACK_ENABLED=1
AI_PRICE_FALLBACK_MAX_ASSETS=3
AI_PRICE_FALLBACK_MODEL=gemini-2.5-flash

# Optional Crypto sheet overrides: separate credentials instead of
# CRYPTO_SHEET_SERVICE_ACCOUNT_JSON, and the holdings detail range.
CRYPTO_SHEET_CLIENT_EMAIL=sheet-reader@your-project-id.iam.gserviceaccount.com
CRYPTO_SHEET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CRYPTO_SHEET_DETAIL_RANGE='2026_V2'!G38:M73
