{
  "name": "portfolio-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm test && node scripts/gen-price-freshness.mjs && npm run check:server-runtime",
    "build": "tsc -b && vite build",
    "build:fast": "vite build",
    "typecheck": "tsc -b",
    "gen:shared-js": "node scripts/build-shared-js.mjs",
    "pretest": "node scripts/build-shared-js.mjs",
    "test": "node --experimental-strip-types --test",
    "ci": "npm run build",
    "preview": "vite preview",
    "diagnose:coingecko": "node scripts/checkCoinGeckoCrypto.mjs",
    "crypto-history:preview": "node scripts/import-crypto-history.mjs",
    "crypto-history:apply": "node scripts/import-crypto-history.mjs --apply",
    "gen-freshness": "node scripts/gen-price-freshness.mjs",
    "check:server-runtime": "node scripts/check-server-runtime.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@vercel/functions": "^3.9.11",
    "firebase": "^12.11.0",
    "firebase-admin": "14.5.0",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@types/jspdf": "^1.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  },
  "engines": {
    "node": "24.x"
  }
