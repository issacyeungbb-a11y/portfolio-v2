{
  "name": "portfolio-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-price-freshness.mjs && node scripts/build-shared-js.mjs",
    "build": "tsc -b && vite build",
    "build:fast": "vite build",
    "typecheck": "tsc -b",
    "gen:shared-js": "node scripts/build-shared-js.mjs",
    "pretest": "node scripts/build-shared-js.mjs",
    "test": "node --experimental-strip-types --test",
    "ci": "npm test && npm run build",
    "preview": "vite preview",
    "diagnose:coingecko": "node scripts/checkCoinGeckoCrypto.mjs",
    "crypto-history:preview": "node scripts/import-crypto-history.mjs",
    "crypto-history:apply": "node scripts/import-crypto-history.mjs --apply",
    "gen-freshness": "node scripts/gen-price-freshness.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@types/jspdf": "^1.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
