{
  "fluid": true,
  "headers": [{
    "source": "/connections",
    "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Cache-Control", "value": "private, no-store" }
    ]
  }],
  "functions": {
    "api/health.ts": {
      "maxDuration": 120
    },
    "api/cron-monthly-analysis.ts": {
      "maxDuration": 300
    },
    "api/manual-quarterly-report.ts": {
      "maxDuration": 300
    },
    "api/cron-daily-update.ts": {
      "maxDuration": 120
    },
    "api/cron-daily-rescue.ts": {
      "maxDuration": 120
    },
    "api/update-prices.ts": {
      "maxDuration": 60
    },
    "api/manual-capture-snapshot.ts": {
      "maxDuration": 60
    },
    "api/analyze.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/mcp", "destination": "/api/health?oauthEndpoint=/api/mcp" },
    { "source": "/authorize", "destination": "/api/health?oauthEndpoint=/authorize" },
    { "source": "/token", "destination": "/api/health?oauthEndpoint=/token" },
    { "source": "/register", "destination": "/api/health?oauthEndpoint=/register" },
    { "source": "/revoke", "destination": "/api/health?oauthEndpoint=/revoke" },
    { "source": "/oauth/manage", "destination": "/api/health?oauthEndpoint=/oauth/manage" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/health?oauthEndpoint=/.well-known/oauth-authorization-server" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/health?oauthEndpoint=/.well-known/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/health?oauthEndpoint=/.well-known/oauth-protected-resource/api/mcp" },
    {
      "source": "/assets",
      "destination": "/index.html"
    },
    {
      "source": "/api/portfolio-public",
      "destination": "/api/health?portfolioPublic=1"
    },
    {
      "source": "/api/portfolio-transactions-public",
      "destination": "/api/health?portfolioTransactionsPublic=1"
    },
    {
      "source": "/((?!api/|api$|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-daily-update",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron-daily-rescue",
      "schedule": "0 0 * * *"
    }
  ]
}
